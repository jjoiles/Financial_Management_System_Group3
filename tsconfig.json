{
  // F17 requirement: analytics UI and route files are included in compilation.
  "include": ["src", "vite.config.ts", "eslint.config.js"],
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    // F17 requirement: strict typing for the analytics dashboard state, data mappings, and charts.
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    // F17 requirement: Vite/TanStack bundler settings support the React route and alias imports used by analytics.tsx.
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // F17 requirement: TSX page support for React components, hooks, and chart rendering.
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    // F17 requirement: path alias resolution for imports like '@/lib/mock-data'.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
